<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Wavvy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- The search by sound over another app, it has no background of its own so the app under it stays in sight -->
    <style name="Theme.Wavvy.Overlay" parent="Theme.Wavvy">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
